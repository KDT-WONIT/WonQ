{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WONIT job request v1",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "chatbot",
        "report",
        "inspection",
        "monitoring"
      ]
    }
  }
}
